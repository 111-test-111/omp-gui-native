    "Copy handoff" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "复制交接内容"}}}},
    "Save handoff…" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "另存交接…"}}}},
    "Handoff document" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "交接内容"}}}},
    "Handoff saved." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "交接内容已保存。"}}}},
    "Refresh to load the handoff document from native session history." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "刷新以从原生会话历史中读取交接内容。"}}}},
    "OMP did not respond to the context refresh. Refresh again after its current work finishes." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 未响应上下文刷新。请等待当前工作完成后再刷新。"}}}},
    "Delivery is unknown. OMP may still be processing this message; it will not be sent again automatically." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "送达结果未知。OMP 可能仍在处理此消息；此消息不会自动重发。"}}}},
    "Delivery unknown" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "送达结果未知"}}}},
    "Delivery was not observed before this conversation was reopened. The message will not be resent automatically." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "重新打开此对话前，尚未确认消息已送达。此消息不会自动重发。"}}}},
    "Disable" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "停用"}}}},
    "Dismiss consumed message" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "移除已读取消息的记录"}}}},
    "Enable" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "启用"}}}},
    "Export HTML…" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "导出 HTML…"}}}},
    "Handoff completed. Saved in this session." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "交接已完成，内容已保存在本会话中。"}}}},
    "Incomplete response" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "回复未完成"}}}},
    "Input tokens" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "输入 token"}}}},
    "Message delivery" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "消息送达方式"}}}},
    "Missing native statistics are unknown." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "未提供的原生统计信息显示为未知。"}}}},
    "Native branch created. Original conversation saved as %@. File restoration is reported separately." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "原生分支已创建，原会话已保存为“%@”。文件恢复结果会单独报告。"}}}},
    "Native history changed. Reload it before continuing." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "原生历史记录已更改。请重新加载后继续。"}}}},
    "Native session statistics" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "原生会话统计"}}}},
    "No native OMP history is available for this conversation." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "此会话没有可用的 OMP 原生历史。"}}}},
    "Not submitted" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "尚未提交"}}}},
    "OMP changed the session while branching failed. The connection was closed; the original conversation is preserved." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "创建分支失败期间，OMP 已更改会话。连接已关闭，原对话已保留。"}}}},
    "OMP created a branch but its new session identity could not be read. The original conversation is preserved." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 已创建分支，但无法读取新会话的身份信息。原对话已保留。"}}}},
    "OMP creates a branch before this message and restores its prompt. The original conversation remains available. File restoration is a separate operation." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 会在此消息之前创建分支，并恢复其提示内容。原会话仍可查看，文件恢复将单独执行。"}}}},
    "OMP delivery" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 送达状态"}}}},
    "OMP did not confirm delivery. This message will not be sent again automatically." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 尚未确认送达。此消息不会自动重发。"}}}},
    "OMP did not confirm the branch result. The connection was closed to protect the original conversation; reopen it before retrying." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 未确认分支结果。为保护原对话，连接已关闭；请重新打开对话后再试。"}}}},
    "OMP did not create a handoff." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 未创建交接。"}}}},
    "OMP did not report a compaction result." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 未提供压缩结果。"}}}},
    "OMP did not report a handoff result." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 未提供交接结果。"}}}},
    "OMP did not report the exported file path." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 未提供导出文件路径。"}}}},
    "OMP disconnected before this message was observed in the conversation. Delivery is unknown; it will not be resent automatically." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "在对话中确认此消息前，OMP 已断开连接。送达结果未知；此消息不会自动重发。"}}}},
    "OMP has not confirmed the context action. Its outcome is unknown; do not repeat it while confirmation is pending." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 尚未确认该上下文操作。结果未知；等待确认期间请勿重复执行。"}}}},
    "OMP is not ready to accept this message. Your draft has been kept." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 尚未准备好接收此消息。草稿已保留。"}}}},
    "OMP owns accepted messages. Editing and withdrawal are unavailable in this protocol." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "已接收的消息由 OMP 管理。此协议不支持编辑或撤回。"}}}},
    "OMP preserves the original conversation. Eligible files are restored separately to their state before this turn." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 会保留原会话，并单独将符合恢复条件的文件还原到此轮之前的状态。"}}}},
    "OMP returned invalid native history." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 返回的原生历史记录无效。"}}}},
    "OMP skipped context compaction." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 已跳过上下文压缩。"}}}},
    "OMP will retry after compaction." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 将在压缩后重试。"}}}},
    "Output tokens" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "输出 token"}}}},
    "Reasoning tokens" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "推理 token"}}}},
    "Refresh native context and statistics" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "刷新原生上下文和统计信息"}}}},
    "Reported cost (USD)" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "报告费用（美元）"}}}},
    "Return supplements the current task. The delivery menu also offers follow-up and stop-and-send." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "按 Return 补充当前任务。送达菜单还提供任务结束后执行和停止并发送。"}}}},
    "Reveal file" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "在访达中显示文件"}}}},
    "Sending creates a native branch before this message. The original conversation remains available." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "发送时会在此消息之前创建原生分支，原会话仍可查看。"}}}},
    "Session exported." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "会话已导出。"}}}},
    "Session idle" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "会话空闲"}}}},
    "Stop and send" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "停止并发送"}}}},
    "Stop the current OMP task" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "停止当前 OMP 任务"}}}},
    "Submission failed" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "提交失败"}}}},
    "Submit to OMP" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "提交给 OMP"}}}},
    "Submitting to OMP…" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "正在提交给 OMP…"}}}},
    "Supplement current task" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "补充当前任务"}}}},
    "The native branch was created, but files could not be restored: %@" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "原生分支已创建，但文件未能恢复：%@"}}}},
    "The native tree is read-only. This OMP interface does not switch to arbitrary nodes." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "原生历史树仅供查看。此 OMP 接口不支持切换到任意节点。"}}}},
    "This OMP process does not support automatic compaction controls." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "此 OMP 进程不支持自动压缩控制。"}}}},
    "This OMP process does not support this context action." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "此 OMP 进程不支持该上下文操作。"}}}},
    "This draft already has a pending or unknown delivery. Check the message queue before sending it again." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "此草稿已有一次送达尚待确认或结果未知。再次发送前，请检查消息队列。"}}}},
    "This message was already submitted. Check its delivery status before sending again." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "此消息已提交。再次发送前，请检查其送达状态。"}}}},
    "This native entry is not a user message on the current path." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "此原生条目不是当前路径上的用户消息。"}}}},
    "This native message cannot be reliably linked to the displayed history. The original conversation remains available." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "无法将这条原生消息可靠地关联到当前显示的历史。原会话仍可查看。"}}}},
    "Tool calls" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "工具调用"}}}},
    "Total tokens" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "token 总数"}}}},
    "Unknown" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "未知"}}}},
    "Use OMP's native context action" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "使用 OMP 的原生上下文操作"}}}},
    "User" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "用户"}}}},
    "User messages" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "用户消息"}}}},
    "Wait for OMP to finish before reading or branching history." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "请等待 OMP 完成当前工作后，再读取历史记录或创建分支。"}}}},
    "Wait until OMP has confirmed the context action before sending another message." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "请等待 OMP 确认上下文操作后再发送消息。"}}}},
    "Wait until OMP has finished its current work before branching." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "请等待 OMP 完成当前工作后再创建分支。"}}}},
    "Wait until OMP has finished its current work before managing context." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "请等待 OMP 完成当前工作后再管理上下文。"}}}},
    "OMP is processing queued messages." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 正在处理排队消息。"}}}},
    "OMP is compacting context." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 正在压缩上下文。"}}}},
    "OMP is retrying the request." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 正在重试请求。"}}}},
    "OMP is processing a request." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 正在处理请求。"}}}},
    "Document metadata" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "文档元数据"}}}},
