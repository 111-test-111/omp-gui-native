    "Consumed by OMP" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 已读取"}}}},
    "Context actions are available when OMP has finished its current work." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 完成当前工作后，即可执行上下文操作。"}}}},
    "Context compaction completed: before %@ tokens → after %@ tokens" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "上下文压缩已完成：压缩前 %@ token → 压缩后 %@ token"}}}},
