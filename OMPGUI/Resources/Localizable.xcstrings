    "Skip question" : {"extractionState": "manual","localizations": {"zh-Hans": {"stringUnit": {"state": "translated","value": "跳过此题"}}}},
    "Skip all" : {"extractionState": "manual","localizations": {"zh-Hans": {"stringUnit": {"state": "translated","value": "全部跳过"}}}},
    "Select one or more options" : {"extractionState": "manual","localizations": {"zh-Hans": {"stringUnit": {"state": "translated","value": "可选择一个或多个选项"}}}},
    "Select one option" : {"extractionState": "manual","localizations": {"zh-Hans": {"stringUnit": {"state": "translated","value": "请选择一个选项"}}}},
    "Selected" : {"extractionState": "manual","localizations": {"zh-Hans": {"stringUnit": {"state": "translated","value": "已选中"}}}},
    "Not selected" : {"extractionState": "manual","localizations": {"zh-Hans": {"stringUnit": {"state": "translated","value": "未选中"}}}},
    "The user skipped this question without answering." : {"extractionState": "manual","localizations": {"zh-Hans": {"stringUnit": {"state": "translated","value": "用户跳过了此问题，未作回答。"}}}},
    "OMP GUI could not preserve unreadable chat files. Sending and saving are paused. Check the library's disk space and permissions, then reopen this chat." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP GUI 无法保留无法读取的聊天文件，已暂停发送和保存。请检查聊天库所在磁盘的空间与权限，然后重新打开此聊天。"}}}},
    "A request with this ID is already pending." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "已有使用此 ID 的请求正在等待响应。"}}}},
    "OMP returned a response for a different command." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 返回了与请求命令不符的响应。"}}}},
    "This OMP installation does not support recalling queued messages." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "当前 OMP 安装不支持撤回队列消息。"}}}},
    "OMP could not uniquely identify this queued message. It was left in the native queue." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 无法唯一识别此队列消息，已将其保留在原生队列中。"}}}},
    "OMP could not complete the queued-message action. The message was not restored or deleted locally." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 未能完成队列消息操作，消息尚未回填到输入框或从本地删除。"}}}},
    "Recall follow-up" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "撤回并回填输入框"}}}},
    "Delete follow-up" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "删除后续消息"}}}},
    "OMP already started this message. It cannot be withdrawn." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 已开始处理此消息，无法撤回。"}}}},
    "System notice" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "系统通知"}}}},
    "Show system notice" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "展开系统通知"}}}},
    "Hide system notice" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "收起系统通知"}}}},
    "Steps" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "步骤"}}}},
    "Dismiss the panel; heads keep working" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "关闭面板；子代理会继续工作"}}}},
    "OMP could not list sign-in providers. Sign in with its native terminal, then reload this page." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 未能列出登录提供商。请在原生终端中登录，然后重新载入此页面。"}}}},
    "The native branch was created. Restored %lld files; kept %lld files with later changes." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "已创建原生分支。已恢复 %lld 个文件；%lld 个文件存在后续更改，已予以保留。"}}}},
    "Restored %lld files to the selected checkpoint." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "已将 %lld 个文件恢复到选定的检查点。"}}}},
    "OMP reused this agent ID. Controls are available only for its current task." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 已复用此代理 ID。控制操作仅适用于其当前任务。"}}}},
    "Built-in command" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "内置命令"}}}},
