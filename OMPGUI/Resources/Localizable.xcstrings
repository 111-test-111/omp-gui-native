    "Empty answer" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "空答案"}}}},
    "No saved answer" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "没有保留的答案"}}}},
    "Native observation" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "原生观测身份"}}}},
    "Preview" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "预览"}}}},
    "Disconnected" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "已断开"}}}},
    "OMP did not confirm the diagnostic refresh. Previous observations may be stale." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 尚未确认诊断刷新。先前观测可能已过时。"}}}},
    "Supported" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "支持"}}}},
    "The native process disconnected." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "原生进程已断开连接。"}}}},
    "Unsupported" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "不支持"}}}},
