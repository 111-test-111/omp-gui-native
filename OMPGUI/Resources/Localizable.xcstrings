    "Plugin scope" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "插件范围"}}}},
    "The native plugin registry is separate from the chat command catalog." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "原生插件注册表与对话命令目录分别管理。"}}}},
    "Installed plugins" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "已安装插件"}}}},
    "Run diagnostics" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "运行诊断"}}}},
    "No native plugins installed" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "尚未安装原生插件"}}}},
    "Uninstall" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "卸载"}}}},
    "Install native plugin" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "安装原生插件"}}}},
    "Enter an npm package, local path, or native marketplace identifier." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "输入 npm 包、本地路径或原生插件市场标识符。"}}}},
    "Project scope applies to marketplace plugins. OMP stores npm packages and local links in its user plugin directory." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "项目范围适用于插件市场中的插件。OMP 将 npm 包和本地链接保存在其用户插件目录中。"}}}},
    "Plugin package or path" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "插件包或路径"}}}},
    "Uninstall native plugin?" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "卸载原生插件？"}}}},
    "Continue in OMP terminal" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "在 OMP 终端中继续"}}}},
    "Open OMP MCP terminal" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "打开 OMP MCP 终端"}}}},
    "Configured enabled · connection unknown" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "已配置启用 · 连接状态未知"}}}},
    "Configured disabled · connection unknown" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "已配置禁用 · 连接状态未知"}}}},
    "MCP configuration is read from native files. This OMP RPC version does not report server connection state; enabled configuration does not confirm a connection." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "MCP 配置从原生文件读取。当前 OMP RPC 版本不提供服务器连接状态；配置为启用并不代表已经连接。"}}}},
    "OMP active profile configuration" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 活动 profile 配置"}}}},
    "Disabled native agents" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "已禁用的原生子代理"}}}},
    "Enter one native agent name per line. Leave blank to allow all configured agents." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "每行输入一个原生子代理名称。留空则允许所有已配置的子代理。"}}}},
    "Enabled" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "已启用"}}}},
    "Disabled" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "已禁用"}}}},
    "Add file location to question" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "将文件位置加入提问"}}}},
    "Add selected source text to question" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "将所选源代码文本加入提问"}}}},
    "Show source and select text to add it to your question." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "请显示源代码并选择文本，再将其加入提问。"}}}},
    "Select source text to add it to your question." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "请选择要加入提问的源代码文本。"}}}},
    "Add file context from the preview before OMP can read it." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "请先从预览中加入文件上下文，OMP 才能读取。"}}}},
    "The requested file location is outside the selected worktree." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "请求的文件位置不在所选 worktree 内。"}}}},
    "Open this conversation to show its file preview." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "请打开此会话以显示其文件预览。"}}}},
    "Selected file context" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "所选文件上下文"}}}},
    "Open file location" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "打开文件位置"}}}},
    "Shared with OMP" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "已与 OMP 共享"}}}},
    "Clear shared file context" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "清除共享文件上下文"}}}},
    "Copy message text" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "复制消息文本"}}}},
    "Dismiss completed message" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "移除已处理消息的记录"}}}},
    "Finished by OMP" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 已完成处理"}}}},
    "OMP finished this request. Its user entry could not be matched; the original message is retained here." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 已完成此请求，但无法匹配对应的用户消息记录；原消息仍保留在此处。"}}}},
    "OMP is settled and its queue is empty. This message's individual consumption could not be verified." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 已结束当前工作，队列为空。尚无法逐条确认此消息是否已被读取。"}}}},
    "The conversation is changing. Your draft has been kept." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "对话正在切换。草稿已保留。"}}}},
    "The conversation is not ready yet. Your draft has been kept." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "对话尚未准备就绪。草稿已保留。"}}}},
    "The conversation or project is no longer available. Your draft has been kept." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "此对话或项目已不可用。草稿已保留。"}}}},
    "The task stopped before this message was submitted. Your draft has been kept." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "此消息提交前，任务已停止。草稿已保留。"}}}},
    "This conversation is archived. Your draft has been kept." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "此对话已归档。草稿已保留。"}}}},
    "%@ (original)" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "%@（原会话）"}}}},
    "%d messages" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "%d 条消息"}}}},
    "1 message" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "1 条消息"}}}},
    "Accepted by OMP" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 已接收"}}}},
    "After current task" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "当前任务结束后执行"}}}},
    "An OMP extension declined this branch. The original conversation is unchanged." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 扩展拒绝了此次分支操作，原会话保持不变。"}}}},
    "An attached image could not be read. The message was not submitted." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "无法读取一张附加图片。消息尚未提交。"}}}},
