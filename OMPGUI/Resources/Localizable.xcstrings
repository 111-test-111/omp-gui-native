    "Staged changes" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "已暂存更改"}}}},
    "The history display limit is reached. Narrow the history scope to continue browsing." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "已达到历史显示上限，请缩小历史范围后继续浏览。"}}}},
    "The repository changed during this read. Refresh to read its current state." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "仓库在读取期间发生变化，请刷新以读取当前状态。"}}}},
    "This Git result exceeds the browser's size limit. Narrow the scope or open the repository externally." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "此 Git 结果超过浏览器的大小上限，请缩小范围或在外部应用中打开仓库。"}}}},
