    "The OMP configuration changed. Reopen the editor before saving." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 配置已更改。请重新打开编辑器后再保存。"}}}},
    "The model configuration cannot be read. Fix the file before editing API keys." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "无法读取模型配置。请修复配置文件后再编辑 API Key。"}}}},
    "OMP rejected the updated model configuration. Other provider settings may require this API key." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 拒绝了更新后的模型配置。该服务商的其他设置可能需要此 API Key。"}}}},
