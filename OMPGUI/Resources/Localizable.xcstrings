    "MCP configuration is busy. Try again after the other editor finishes." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "MCP 配置正忙，请等待其他编辑器完成后重试。"}}}},
    "MCP configuration must be a regular file, not a symbolic link." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "MCP 配置必须是普通文件，不能是符号链接。"}}}},
