    "Enter a shorter search query." : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"请输入较短的搜索内容。"}}}},
    "Search the web" : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"搜索网页"}}}},
    "Enter an HTTP or HTTPS address, or localhost with a port." : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"请输入 HTTP 或 HTTPS 地址，或带端口的 localhost 地址。"}}}},
    "The embedded browser could not start. Check the browser runtime in this app bundle." : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"内嵌浏览器无法启动。请检查应用包中的浏览器运行组件。"}}}},
    "This browser tab has closed. List the current tabs before continuing." : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"此浏览器标签页已关闭。请先列出当前标签页再继续。"}}}},
    "Close a browser tab before opening another. Each conversation supports 16 tabs and the app supports 64 live tabs." : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"请先关闭一个浏览器标签页再打开新页。每个会话最多支持 16 个标签页，应用最多同时运行 64 个标签页。"}}}},
    "OMP could not identify this browser page. Reload the tab to reconnect." : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"OMP 无法识别此浏览器页面。请重新加载标签页以重新连接。"}}}},
    "Embedded browser automation requires the supported OMP SDK. Ordinary browsing is still available." : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"内嵌浏览器自动化需要受支持的 OMP SDK。仍可正常手动浏览。"}}}},
    "New browser tab" : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"新建浏览器标签页"}}}},
    "The page could not load: %@" : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"页面无法加载：%@"}}}},
    "The browser page stopped responding. Reload to recover it." : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"浏览器页面已停止响应。请重新加载以恢复。"}}}},
    "This link uses a protocol that the embedded browser does not open." : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"此链接使用内嵌浏览器不支持打开的协议。"}}}},
    "A popup was blocked. Open the link directly to continue." : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"已拦截弹出窗口。请直接打开链接以继续。"}}}},
    "This site requested a device permission. Use the default browser for camera, microphone or location access." : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"此网站请求设备权限。如需摄像头、麦克风或定位权限，请使用默认浏览器。"}}}},
    "Open a browser tab to browse with OMP." : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"打开浏览器标签页，与 OMP 一起浏览。"}}}},
