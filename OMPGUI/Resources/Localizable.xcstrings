    "Automatic image selection" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "自动选择图片模型"}}}},
    "Configured image model unavailable" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "已配置的图片模型不可用"}}}},
    "OMP chooses an image model for each conversation. Select a backend to check its credentials." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 为每个会话选择图片模型。选择一个后端可检查其凭据。"}}}},
    "The saved image selector is not in the installed image catalogue. Select a backend or use Automatic." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "已保存的图片模型选择器不在当前安装的图片模型目录中。请选择一个后端或使用自动选择。"}}}},
    "Sign in to this provider or add its API key in Edit model configuration." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "请登录此服务商，或在“编辑模型配置”中添加其 API Key。"}}}},
    "Sign in to this provider using its existing OMP login." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "请通过 OMP 的现有登录方式登录此服务商。"}}}},
    "Add this provider's API key in Edit model configuration." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "请在“编辑模型配置”中添加此服务商的 API Key。"}}}},
    "Configure %@ in OMP's environment, then reload." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "请在 OMP 的环境中配置 %@，然后重新加载。"}}}},
    "Configure this provider's credentials in OMP, then reload." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "请在 OMP 中配置此服务商的凭据，然后重新加载。"}}}},
    "OMP could not check image backend credentials. Reload or check its native credential store." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 无法检查图片后端凭据。请重新加载或检查其原生凭据存储。"}}}},
    "OMP could not read image settings. Check its native model configuration and reload." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 无法读取图片设置。请检查其原生模型配置后重新加载。"}}}},
    "Image backend settings require an OMP npm installation with its native image SDK and Bun." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "图片后端设置需要通过 npm 安装的 OMP、其原生图片 SDK 和 Bun。"}}}},
    "The model configuration could not be saved. Check file permissions and reopen the editor." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "无法保存模型配置。请检查文件权限并重新打开编辑器。"}}}},
