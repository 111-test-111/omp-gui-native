    "The OMP configuration changed on disk. Reload before saving." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "磁盘上的 OMP 配置已更改。请重新载入后再保存。"}}}},
    "Saved to the active OMP profile. Project and process overrides may supply different effective values in a chat." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "保存到 OMP 当前活动 profile。项目和进程级覆盖配置可能使对话中的实际生效值不同。"}}}},
    "Native model selector or role alias" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "原生模型选择器或角色别名"}}}},
    "Leave a field blank to remove that assignment. Other native configuration fields are preserved." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "将字段留空可移除该项分配。其他原生配置字段会保留。"}}}},
    "Active profile" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "活动 profile"}}}},
    "OMP configuration is busy. Wait for it to finish and try again." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 正在处理配置。请等待完成后重试。"}}}},
