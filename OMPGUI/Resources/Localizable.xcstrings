    "Sending response…" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "正在发送回复…"}}}},
    "This OMP process has not confirmed support for additional worker instructions." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "此 OMP 进程尚未确认支持向 worker 发送追加指令。"}}}},
    "MCP" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "MCP"}}}},
