    "Cache write" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "缓存写入"}}}},
    "Model details" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "模型详情"}}}},
    "View model details" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "查看模型详情"}}}},
    "Details for %@" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "%@ 的详情"}}}},
    "All models are shown by default. Hidden models stay available here but do not appear in the composer picker." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "默认显示全部模型。隐藏的模型仍保留在此处，但不会出现在输入框底部的模型选择器中。"}}}},
    "All models are hidden. Enable models in Settings → Models." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "全部模型均已隐藏。请前往「设置 → 模型」启用模型。"}}}},
    "Default settings for %@" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "%@ 的默认参数"}}}},
    "Hide all" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "隐藏全部"}}}},
    "Enable all" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "启用全部"}}}},
    "Hide all models from %@" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "隐藏 %@ 的全部模型"}}}},
    "Enable all models from %@" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "启用 %@ 的全部模型"}}}},
    "Enable %@ in the picker" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "在选择器中启用 %@"}}}},
    "Hide %@ from the picker" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "在选择器中隐藏 %@"}}}},
    "Shown" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "已显示"}}}},
    "Open containing folder" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "打开所在文件夹"}}}},
    "Skills" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "技能"}}}},
    "Global skills" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "全局技能"}}}},
    "Global skills discovered by OMP. Project skills are excluded." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 发现的全局技能，不包含项目技能。"}}}},
    "OMP did not report any global skills." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 未提供任何全局技能。"}}}},
    "Preview SKILL.md" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "预览 SKILL.md"}}}},
    "Loading global skills" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "正在加载全局技能"}}}},
    "Refresh global skills" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "刷新全局技能"}}}},
    "SKILL.md view" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "SKILL.md 视图"}}}},
    "Source" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "源码"}}}},
    "Refresh memory preview" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "刷新记忆预览"}}}},
    "Loading memory files" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "正在加载记忆文件"}}}},
    "OMP did not report any global memory files." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 未提供任何全局记忆文件。"}}}},
    "Memory files" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "记忆文件"}}}},
    "Project memory" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "项目记忆"}}}},
    "Global shared memory" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "全局共享记忆"}}}},
    "Preview limit reached. Some entries may be omitted or shortened." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "已达到预览上限，部分条目可能省略或截短。"}}}},
    "No saved memories to preview for this request." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "本次请求没有可预览的已保存记忆。"}}}},
    "This OMP SDK does not expose memory file previews." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "此 OMP SDK 未提供记忆文件预览接口。"}}}},
    "OMP did not report a memory file path." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 未提供记忆文件路径。"}}}},
    "This memory file is no longer available for the selected conversation." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "此记忆文件已不适用于所选会话。"}}}},
    "Mnemopi" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "Mnemopi"}}}},
    "Memory" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "记忆"}}}},
    "Long-term memory" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "长期记忆"}}}},
    "Enable memory" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "启用记忆"}}}},
    "Use OMP Mnemopi to remember project knowledge and shared preferences across conversations. Off by default." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "使用 OMP Mnemopi 跨会话记住项目知识和共享偏好。默认关闭。"}}}},
    "Memory scope" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "记忆范围"}}}},
    "Project memory + global shared memory. Worktrees of the same Git repository share project memory; separate clones stay separate." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "项目记忆＋全局共享记忆。同一 Git 仓库的 worktree 共享项目记忆；独立克隆保持隔离。"}}}},
    "Automatic recall" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "自动召回"}}}},
    "OMP recalls relevant memories before the first model response and keeps the native prompt snapshot with the conversation." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 在模型首次回复前召回相关记忆，并随会话保存原生提示词快照。"}}}},
    "Automatic retention" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "自动保存记忆"}}}},
    "OMP saves completed turns to project memory. Ask the agent to save shared preferences with global scope." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 将已完成的轮次保存到项目记忆。可要求代理将共享偏好保存为全局记忆。"}}}},
    "Memory language" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "记忆语言"}}}},
    "The embedding model is managed by OMP. An explicit native embedding model takes precedence." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "嵌入模型由 OMP 管理。显式配置的原生嵌入模型优先。"}}}},
    "Multilingual" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "多语言"}}}},
    "Memory context budget" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "记忆上下文预算"}}}},
    "Approximate token limit for native memory instructions and recalled facts." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "原生记忆说明和召回事实的近似 token 上限。"}}}},
    "Changes wait for idle conversations, let OMP finish saving, and close existing connections. The next request uses the new configuration. Turning memory off preserves saved memories and conversation history." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "更改需等待会话空闲，让 OMP 完成保存并关闭现有连接。下次请求使用新配置。关闭记忆会保留已保存的记忆和会话历史。"}}}},
    "Saving memory and closing OMP connections…" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "正在保存记忆并关闭 OMP 连接…"}}}},
    "Wait for all conversations and background work to finish before changing memory." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "请等待所有会话和后台工作结束后再更改记忆设置。"}}}},
    "Enable memory and select a conversation to inspect it." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "启用记忆并选择一个会话后即可查看。"}}}},
    "Memory requires an OMP installation with the Mnemopi SDK and Bun." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "记忆功能需要包含 Mnemopi SDK 的 OMP 安装以及 Bun。"}}}},
    "OMP did not confirm that memory is enabled." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 未确认记忆已启用。"}}}},
    "OMP could not inspect memory." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 无法查看记忆。"}}}},
    "OMP is saving memory and closing its connections. Wait for the change to finish." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 正在保存记忆并关闭连接。请等待更改完成。"}}}},
    "Save the conversation before changing memory." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "请先保存会话，再更改记忆设置。"}}}},
    "This OMP SDK does not expose the required Mnemopi lifecycle interfaces." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "此 OMP SDK 未提供所需的 Mnemopi 生命周期接口。"}}}},
    "OMP could not initialise Mnemopi. Check the native memory configuration." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 无法初始化 Mnemopi。请检查原生记忆配置。"}}}},
    "Wait for OMP to finish before changing the memory scope." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "请等待 OMP 结束工作后再更改记忆范围。"}}}},
    "Invalid memory query." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "记忆查询无效。"}}}},
    "The native session changed during memory inspection." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "查看记忆期间原生会话发生了变化。"}}}},
    "This worker journal is outside this OMP GUI library." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "此子代理日志不在当前 OMP GUI 库中。"}}}},
    "This worker journal exceeds the history display limit." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "此子代理日志超出了历史显示上限。"}}}},
    "OMP GUI could not read this worker journal. Its original contents are preserved." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP GUI 无法读取此子代理日志。原始内容已保留。"}}}},
    "OMP has not saved any worker messages yet." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 尚未保存任何子代理消息。"}}}},
    "Loading OMP worker history…" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "正在加载 OMP 子代理历史…"}}}},
    "OMP's model channel rejected a message during an active response. OMP manages retry and delivery; the original error is retained in this turn." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 模型通道在回复进行中拒绝了一条消息。重试与投递由 OMP 管理；原始错误保留在本轮中。"}}}},
    "Sending out %lld heads" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "正在派出 %lld 个子代理"}}}},
    "Sent out %lld heads" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "已派出 %lld 个子代理"}}}},
    "Delegated heads" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "已派出的子代理"}}}},
    "%lld heads finished working" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "%lld 个子代理已完成工作"}}}},
    "Completed heads" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "已完成的子代理"}}}},
    "%d approvals" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "%d 项审批"}}}},
    "Wait for OMP to confirm Fast mode before sending." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "请等待 OMP 确认 Fast 模式后再发送。"}}}},
    "Wait for OMP to finish before changing this model's Fast mode." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "请等待 OMP 完成当前工作后，再更改此模型的 Fast 模式。"}}}},
    "A head gets a self-contained brief and its own panel beside the chat." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "每个子代理收到独立完整的任务简报，并在聊天旁拥有自己的面板。"}}}},
    "A pair says which model leads and which model runs the heads. Pairs live in the model picker and in Settings › Hydra." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "模型配对指定由哪个模型担任主代理、哪个模型运行子代理。可在模型选择器和「设置 › Hydra」中管理配对。"}}}},
    "A pair says which model leads and which runs the heads." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "模型配对指定由哪个模型担任主代理、哪个模型运行子代理。"}}}},
    "Allow all" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "全部允许"}}}},
    "Allows every pending approval once" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "允许所有待审批的请求（仅本次）"}}}},
    "Approval %d" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "第 %d 项审批"}}}},
    "Denies every pending approval" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "拒绝所有待审批的请求"}}}},
    "Deny all" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "全部拒绝"}}}},
    "Heads can work in copies of the project, managed by OMP." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "子代理可在由 OMP 管理的项目副本中工作。"}}}},
    "Model" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "模型"}}}},
    "Next approval" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "下一项审批"}}}},
    "Previous approval" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "上一项审批"}}}},
    "need approval" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "需要批准"}}}},
    "Provider" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "服务商"}}}},
    "The lead checks their work, fixes what needs fixing and answers you." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "主代理检查它们的工作，修正需要修正的部分，然后答复你。"}}}},
    "With the switch on, heads can work in copies of the project, managed by OMP." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "开启后，子代理可在由 OMP 管理的项目副本中工作。"}}}},
    "Use your next message as a native goal" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "将下一条消息设为原生目标"}}}},
    "Goal completed" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "目标已完成"}}}},
    "Continue working on the current goal." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "请继续推进当前目标。"}}}},
    "Goal mode is disabled in OMP. Enable goal.enabled in OMP, then reconnect this conversation." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 已禁用目标模式。请在 OMP 中启用 goal.enabled，然后重新连接此会话。"}}}},
    "OMP reported an unfamiliar goal state. Update OMP GUI before changing this goal." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 报告了无法识别的目标状态。请升级 OMP GUI 后再操作此目标。"}}}},
    "This goal has used its token budget. Drop it and create a new goal with a new budget; usage starts at zero." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "此目标已用完 token 预算。请放弃此目标并设置新预算创建目标；新目标的用量从零开始。"}}}},
    "Stop the current reply and pause its goal" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "停止当前回复并暂停其目标"}}}},
    "Stopping the current reply also pauses an active goal." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "停止当前回复也会暂停正在进行的目标。"}}}},
    "Usage reflects OMP's latest report." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "用量以 OMP 最近一次报告为准。"}}}},
    "Remove attachments before sending a goal." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "发送目标前请移除附件。"}}}},
    "Write your goal in the message box." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "在消息输入框中填写目标。"}}}},
    "Describe your goal" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "描述你的目标"}}}},
    "The token budget is a soft limit." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "Token 预算是软性限制。"}}}},
    "Pause or drop does not stop the current reply." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "暂停或放弃不会停止当前回复。"}}}},
    "Update OMP to use side questions." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "请升级 OMP 以使用旁问。"}}}},
    "Update OMP to use native goals." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "请升级 OMP 以使用原生目标。"}}}},
    "Update OMP" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "升级 OMP"}}}},
    "Restart the app after updating." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "升级后请重启应用。"}}}},
    "Refresh" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "刷新"}}}},
    "Not set" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "未设置"}}}},
    "Reload native Slow support and scope before changing it." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "更改前请重新加载原生 Slow 支持情况及影响范围。"}}}},
    "Choose an explicit native cache warming mode." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "请明确选择原生缓存预热模式。"}}}},
    "Cache hit" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "缓存命中"}}}},
    "Goal continuation follows your OMP configuration." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "目标是否持续运行取决于你的 OMP 配置。"}}}},
    "No current goal." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "当前没有目标。"}}}},
    "Refresh to load the current goal." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "刷新以加载当前目标。"}}}},
    "Resume this goal when you are ready to continue." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "准备好继续时，请恢复此目标。"}}}},
    "OMP is already changing a run option." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 已在更改一个运行选项。"}}}},
    "OMP does not support this run option." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 不支持此运行选项。"}}}},
    "This run option requires an explicit enabled value." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "此运行选项需要明确指定启用或停用。"}}}},
    "OMP is not currently retrying." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 当前未在重试。"}}}},
    "OMP returned an invalid run option result. Its outcome is unknown." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 返回了无效的运行选项结果，操作结果未知。"}}}},
    "OMP did not confirm the run option. Its outcome is unknown; do not repeat it while confirmation is pending." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 未确认此运行选项，操作结果未知；等待确认期间请勿重复操作。"}}}},
    "Goal" : {"extractionState": "manual","localizations": {"zh-Hans": {"stringUnit": {"state": "translated","value": "目标"}}}},
    "Native goal" : {"extractionState": "manual","localizations": {"zh-Hans": {"stringUnit": {"state": "translated","value": "原生目标"}}}},
    "Show native goal" : {"extractionState": "manual","localizations": {"zh-Hans": {"stringUnit": {"state": "translated","value": "显示原生目标"}}}},
    "Paused" : {"extractionState": "manual","localizations": {"zh-Hans": {"stringUnit": {"state": "translated","value": "已暂停"}}}},
    "Budget reached" : {"extractionState": "manual","localizations": {"zh-Hans": {"stringUnit": {"state": "translated","value": "已达到预算"}}}},
    "Dropped" : {"extractionState": "manual","localizations": {"zh-Hans": {"stringUnit": {"state": "translated","value": "已放弃"}}}},
    "Wait for OMP to confirm the pending native action." : {"extractionState": "manual","localizations": {"zh-Hans": {"stringUnit": {"state": "translated","value": "请等待 OMP 确认待处理的原生操作。"}}}},
    "The native goal changed. Refresh it before choosing an action." : {"extractionState": "manual","localizations": {"zh-Hans": {"stringUnit": {"state": "translated","value": "原生目标已更改。请刷新后再选择操作。"}}}},
    "Enter a goal within 128 KiB and an optional positive whole token budget." : {"extractionState": "manual","localizations": {"zh-Hans": {"stringUnit": {"state": "translated","value": "请输入不超过 128 KiB 的目标，可选填正整数 token 预算。"}}}},
    "Resume or drop the current goal before creating another." : {"extractionState": "manual","localizations": {"zh-Hans": {"stringUnit": {"state": "translated","value": "请先恢复或放弃当前目标，再创建其他目标。"}}}},
    "There is no current native goal for this action." : {"extractionState": "manual","localizations": {"zh-Hans": {"stringUnit": {"state": "translated","value": "当前没有可执行此操作的原生目标。"}}}},
    "Only a paused native goal can be resumed." : {"extractionState": "manual","localizations": {"zh-Hans": {"stringUnit": {"state": "translated","value": "只能恢复已暂停的原生目标。"}}}},
    "OMP has not confirmed the goal action. Its outcome is unknown; it will not be sent again automatically." : {"extractionState": "manual","localizations": {"zh-Hans": {"stringUnit": {"state": "translated","value": "OMP 尚未确认目标操作。结果未知，不会自动重发。"}}}},
    "OMP rejected the goal action." : {"extractionState": "manual","localizations": {"zh-Hans": {"stringUnit": {"state": "translated","value": "OMP 拒绝了目标操作。"}}}},
    "This OMP process does not support native goal controls." : {"extractionState": "manual","localizations": {"zh-Hans": {"stringUnit": {"state": "translated","value": "此 OMP 进程不支持原生目标控制。"}}}},
    "OMP did not report a valid native goal state." : {"extractionState": "manual","localizations": {"zh-Hans": {"stringUnit": {"state": "translated","value": "OMP 未报告有效的原生目标状态。"}}}},
    "Enter a positive whole token budget, or leave it empty." : {"extractionState": "manual","localizations": {"zh-Hans": {"stringUnit": {"state": "translated","value": "请输入正整数 token 预算，或留空。"}}}},
    "Start or resume this conversation to manage its native goal." : {"extractionState": "manual","localizations": {"zh-Hans": {"stringUnit": {"state": "translated","value": "请先开始或恢复此会话，再管理其原生目标。"}}}},
    "Waiting for OMP to confirm the goal action…" : {"extractionState": "manual","localizations": {"zh-Hans": {"stringUnit": {"state": "translated","value": "正在等待 OMP 确认目标操作…"}}}},
    "Previous observation" : {"extractionState": "manual","localizations": {"zh-Hans": {"stringUnit": {"state": "translated","value": "先前观测"}}}},
    "Goal text is limited to 64 KiB in this view." : {"extractionState": "manual","localizations": {"zh-Hans": {"stringUnit": {"state": "translated","value": "此视图中的目标文本最多显示 64 KiB。"}}}},
    "Goal tokens used" : {"extractionState": "manual","localizations": {"zh-Hans": {"stringUnit": {"state": "translated","value": "目标已用 token"}}}},
    "Token budget" : {"extractionState": "manual","localizations": {"zh-Hans": {"stringUnit": {"state": "translated","value": "Token 预算"}}}},
    "Reported time (seconds)" : {"extractionState": "manual","localizations": {"zh-Hans": {"stringUnit": {"state": "translated","value": "报告的用时（秒）"}}}},
    "OMP counts new input, cache writes and output toward this budget; cache reads are excluded." : {"extractionState": "manual","localizations": {"zh-Hans": {"stringUnit": {"state": "translated","value": "OMP 将新增输入、缓存写入和输出计入此预算，不计入缓存读取。"}}}},
    "Reaching the budget asks OMP to wrap up and stops goal continuation. It is not a hard limit on an in-flight request." : {"extractionState": "manual","localizations": {"zh-Hans": {"stringUnit": {"state": "translated","value": "达到预算后，OMP 会收到收尾提示并停止目标的后续轮次。这不是对进行中请求的硬性限制。"}}}},
    "Resume goal" : {"extractionState": "manual","localizations": {"zh-Hans": {"stringUnit": {"state": "translated","value": "恢复目标"}}}},
    "Pause goal" : {"extractionState": "manual","localizations": {"zh-Hans": {"stringUnit": {"state": "translated","value": "暂停目标"}}}},
    "Drop goal" : {"extractionState": "manual","localizations": {"zh-Hans": {"stringUnit": {"state": "translated","value": "放弃目标"}}}},
    "Pausing or dropping a goal does not abort the current model turn. Use the conversation's Stop action to interrupt it." : {"extractionState": "manual","localizations": {"zh-Hans": {"stringUnit": {"state": "translated","value": "暂停或放弃目标不会中止当前模型轮次。如需中断，请使用会话的停止操作。"}}}},
    "New native goal" : {"extractionState": "manual","localizations": {"zh-Hans": {"stringUnit": {"state": "translated","value": "新建原生目标"}}}},
    "Goal objective" : {"extractionState": "manual","localizations": {"zh-Hans": {"stringUnit": {"state": "translated","value": "目标内容"}}}},
    "Goal text: %d / 131072 bytes" : {"extractionState": "manual","localizations": {"zh-Hans": {"stringUnit": {"state": "translated","value": "目标文本：%d / 131072 字节"}}}},
    "Optional token budget" : {"extractionState": "manual","localizations": {"zh-Hans": {"stringUnit": {"state": "translated","value": "Token 预算（可选）"}}}},
    "Leave the budget empty to use a goal without a token budget." : {"extractionState": "manual","localizations": {"zh-Hans": {"stringUnit": {"state": "translated","value": "预算留空即可创建不设 token 预算的目标。"}}}},
    "Create goal" : {"extractionState": "manual","localizations": {"zh-Hans": {"stringUnit": {"state": "translated","value": "创建目标"}}}},
    "Creating or resuming a goal may start native work when OMP's RPC continuation is enabled. Otherwise, send a message to begin work." : {"extractionState": "manual","localizations": {"zh-Hans": {"stringUnit": {"state": "translated","value": "如果 OMP 已启用 RPC 持续运行，创建或恢复目标可能会启动原生工作。否则，请发送消息以开始工作。"}}}},
    "Side question" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "旁问"}}}},
    "Ask about the current work while the main conversation continues. Side questions cannot use tools." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "在主会话继续工作时，询问有关当前工作的说明。旁问不能调用工具。"}}}},
    "Earlier text is omitted. This topic displays at most 64 KiB; OMP manages the complete record." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "较早的文字已省略。此主题最多显示 64 KiB；完整记录由 OMP 管理。"}}}},
    "Ask a question about this conversation. Its answer stays separate from the main reply." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "就当前会话提出问题。旁问答案与主回复分别显示。"}}}},
    "OMP is saving the side question and closing this connection. Wait for it to finish." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 正在保存旁问并关闭此连接，请等待完成。"}}}},
    "This connection has closed. The displayed topic cannot be continued here." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "此连接已关闭，无法在这里继续当前显示的主题。"}}}},
    "OMP has not confirmed saving this topic." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 尚未确认保存此主题。"}}}},
    "This OMP process does not support side questions." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "此 OMP 进程不支持旁问。"}}}},
    "Start the main conversation before asking a side question." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "请先开始主会话，再发起旁问。"}}}},
    "This topic has reached its 16-turn or 1 MiB limit. Start a new topic to continue asking." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "此主题已达到 16 轮或 1 MiB 上限。请开始新主题继续提问。"}}}},
    "Cancel side question" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "取消旁问"}}}},
    "New topic" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "新主题"}}}},
    "Ask follow-up" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "继续追问"}}}},
    "Ask side question" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "发起旁问"}}}},
    "Your side question" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "你的旁问"}}}},
    "Enter a side question of at most 128 KiB." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "请输入不超过 128 KiB 的旁问。"}}}},
    "Wait for the side question to finish, or start a new topic after its limit." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "请等待旁问完成；主题达到上限后可开始新主题。"}}}},
    "OMP has not confirmed the side question. Do not submit it again while its outcome is unknown." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 尚未确认此旁问。结果未知时请勿再次提交。"}}}},
    "This OMP process cannot cancel side questions." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "此 OMP 进程无法取消旁问。"}}}},
    "OMP could not save the side question." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 无法保存旁问。"}}}},
    "OMP did not provide a complete side-question result. Its outcome is unknown." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 未提供完整的旁问结果，结果仍未知。"}}}},
    "OMP rejected the side question." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 拒绝了此旁问。"}}}},
    "OMP returned an unrecognized side-question record. Its outcome is unknown." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 返回了无法识别的旁问记录，结果仍未知。"}}}},
    "OMP did not confirm side-question cancellation." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 未确认取消旁问。"}}}},
    "OMP did not cancel this side question. Waiting for its native state." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 未取消此旁问，正在等待原生状态。"}}}},
    "Wait for the native session change before asking a side question." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "请等待原生会话切换完成后再发起旁问。"}}}},
    "OMP could not save the side question. Keep this connection open and resolve the native storage error before replacing it." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OMP 无法保存旁问。请保持此连接，并在更换连接前解决原生存储错误。"}}}},
    "The side question must finish saving before OMP can replace this connection." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "旁问必须保存完成，OMP 才能更换此连接。"}}}},
