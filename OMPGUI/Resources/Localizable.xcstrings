{
  "sourceLanguage" : "en",
  "strings" : {
    "JavaScript kernel restarted after an unexpected worker exit; previous variables are no longer available." : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"JavaScript 工作进程意外退出，内核已重启；此前的变量已不再可用。"}}}},
    "A browser profile with this name already exists." : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"已存在同名浏览器配置。"}}}},
    "Import from Chrome" : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"从 Chrome 导入"}}}},
    "Import Chrome cookies" : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"导入 Chrome Cookie"}}}},
    "Import to new profile" : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"导入到新配置"}}}},
    "A Cookie import is already in progress." : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"正在导入 Cookie。"}}}},
    "The browser profile list is full." : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"浏览器配置列表已满。"}}}},
    "OMP GUI Cookie Exporter" : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"OMP GUI Cookie 导出工具"}}}},
    "Export cookies from selected Chrome sites for a new OMP GUI profile." : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"导出所选 Chrome 站点的 Cookie，用于新的 OMP GUI 浏览器配置。"}}}},
    "Choose the sites to export. Chrome will ask for access only to those sites. Access is removed after reading the cookies." : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"选择要导出的站点。Chrome 仅会申请这些站点的访问权限，读取 Cookie 后即撤销。"}}}},
    "Chrome profile name" : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"Chrome 配置名称"}}}},
    "Use Chrome account" : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"使用 Chrome 账号"}}}},
    "Use the name shown in Chrome’s profile menu, or authorize the Chrome account email. A signed-out profile needs a name entered here." : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"填写 Chrome 配置菜单中显示的名称，或授权读取 Chrome 账号邮箱。未登录的配置需要在此填写名称。"}}}},
    "Selected sites, one per line" : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"所选站点，每行一个"}}}},
    "Include subdomains" : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"包含子域名"}}}},
    "Use the base domain for services with several subdomains. Only the selected sites’ cookies are exported, including HttpOnly and partitioned cookies." : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"对于使用多个子域名的服务，请填写主域名。仅导出所选站点的 Cookie，包括 HttpOnly 和分区 Cookie。"}}}},
    "Keep the exported file private: it contains website sign-in cookies. No data is uploaded. Only cookies are exported; some sites may still require sign-in." : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"请妥善保管导出文件，其中包含网站登录 Cookie。不会上传任何数据。仅导出 Cookie，部分站点仍可能要求重新登录。"}}}},
    "Authorize and export cookies" : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"授权并导出 Cookie"}}}},
    "In OMP GUI, open Settings → Browser → Import Cookie file. A new profile ending in [Chrome] becomes active after restarting OMP GUI." : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"在 OMP GUI 中打开“设置 → 浏览器 → 导入 Cookie 文件”。重启 OMP GUI 后启用以 [Chrome] 结尾的新配置。"}}}},
    "Enter between 1 and 64 HTTP or HTTPS sites." : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"请输入 1 至 64 个 HTTP 或 HTTPS 站点。"}}}},
    "Enter the Chrome profile name before exporting." : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"导出前请填写 Chrome 配置名称。"}}}},
    "Chrome access was not granted. No cookies were exported." : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"未获得 Chrome 访问授权，没有导出 Cookie。"}}}},
    "No unexpired cookies were found for these sites." : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"未找到这些站点尚未过期的 Cookie。"}}}},
    "Chrome account email filled in. Account access has been removed." : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"已填写 Chrome 账号邮箱，并撤销账号访问权限。"}}}},
    "Exported $1 cookies from $2 selected sites. Temporary access has been removed." : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"已导出 $2 个所选站点的 $1 个 Cookie，并撤销临时访问权限。"}}}},
    "Cookies could not be exported. Check the selected sites and try again." : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"无法导出 Cookie，请检查所选站点后重试。"}}}},
    "This selection is too large. Export fewer sites at a time." : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"所选数据过多，请分批导出较少的站点。"}}}},
    "Add profile…" : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"添加配置…"}}}},
    "All conversations share this profile. Restart OMP GUI to apply changes." : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"所有会话共用此浏览器配置。更改将在重启 OMP GUI 后生效。"}}}},
    "Browser profile" : {"extractionState":"manual","localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"浏览器配置"}}}},
