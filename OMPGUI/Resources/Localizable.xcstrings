    "Line changes are unavailable. Refresh to try again." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "无法获取增删行数，请刷新后重试。"}}}},
    "Totals compare HEAD with the working tree, including new files. Staging does not change them. Binary contents have no line counts." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "总数统计工作区相对 HEAD 的净变化，包含新文件，不受暂存归属影响。二进制内容不计行数。"}}}},
    "Binary contents have no line counts." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "二进制内容不计行数。"}}}},
    "Line changes for this comparison" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "此比较范围的增删行数"}}}},
    "Choose Git view · all changes: +%lld −%lld" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "选择 Git 视图 · 全部改动：+%lld −%lld"}}}},
    "%lld staged files" : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "%lld 个暂存文件"}}}},
    "Stage files using their row buttons, their diff toolbar, or Stage all changes in the top menu." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "可使用文件行内按钮、差异顶栏，或顶栏菜单中的“暂存所有更改”暂存文件。"}}}},
