    "Use JSON to edit servers with more than 128 arguments, environment variables or headers." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "参数、环境变量或请求头超过 128 项时，请使用 JSON 编辑服务器。"}}}},
    "Use a server name of up to 100 letters, numbers, dots, colons, underscores, hyphens or single spaces." : {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "服务器名称最多 100 个字符，可使用英文字母、数字、点、冒号、下划线、连字符和单个空格。"}}}},
